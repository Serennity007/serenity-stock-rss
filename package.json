{
  "name": "stocks-ai-rss",
  "version": "1.1.3",
  "description": "Nine-section finance RSS for Obsidian: US equities, AI, semiconductors, gold & crypto, macro, plus Chinese, Japanese and Spanish sections. 45 hand-verified feeds, fully local.",
  "license": "GPL-3.0-only",
  "private": true,
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.11",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@types/node": "^26.4.1",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "jsdom": "^30.0.1",
    "obsidian": "^1.13.1",
    "typescript": "^5.4.5",
    "vitest": "^5.0.0"
  }
}
